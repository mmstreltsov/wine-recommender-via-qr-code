# Generate a private .env: python3 scripts/prepare-env.py
# This template has no credentials. Empty required values deliberately fail closed.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Container DSN: host db, port 5432. URL-encode credentials if setting manually.
DATABASE_URL=
# Host-only DSNs for local Go commands and destructive tests (NEVER the same DB).
LOCAL_DATABASE_URL=
M2_IT_DATABASE_URL=

DB_PORT=5432
BACKEND_PORT=8080
COOKIE_MAX_AGE_H=12
AVAILABILITY_TTL_S=5

# Local Go only; compose explicitly uses /app paths and fixed container port 8080.
PORT=8080
RESTAURANT=aidabaran
DATA_DIR=../data
FRONTEND_DIST=../frontend/dist
