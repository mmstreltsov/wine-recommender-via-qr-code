# Порт HTTP-сервера бэкенда
PORT=8080

# DSN PostgreSQL (совпадает с docker-compose.yml сервисом db)
DATABASE_URL=postgres://svoyshef:svoyshef@localhost:5432/svoyshef

# Плагин ресторана и его data-каталог (data/<RESTAURANT>/)
RESTAURANT=aidabaran
DATA_DIR=../data

# Жизнь анонимной сессии (часы); Max-Age cookie = COOKIE_MAX_AGE_H*3600
COOKIE_MAX_AGE_H=12

# TTL (сек) in-memory кэша наличия блюд: задержка подхвата CLI-изменений живым сервером
AVAILABILITY_TTL_S=5
